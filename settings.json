  },
  "enabledPlugins": {
    "claude-research@claude-research": true
  },
  "extraKnownMarketplaces": {
    "claude-research": {
      "source": {
        "source": "directory",
        "path": "~/Documents/claude-research"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "off",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "syncClaudeAiSkills": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/Documents/claude-config/install.sh\" --check >/dev/null || echo '{\"systemMessage\": \"~/.claude does not match claude-config. Run ~/Documents/claude-config/install.sh --check to see what differs, then run install.sh without --check and restart Claude Code.\"}'"
          }
        ]
      }
    ]
  }
