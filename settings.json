{
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "env": {
    "ANTHROPIC_MODEL": "opus",
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "awaySummaryEnabled": false,
  "skipAutoPermissionPrompt": true,
  "tui": "fullscreen",
  "outputStyle": "Concise"
}
