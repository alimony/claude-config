{
  "env": {
    "ANTHROPIC_MODEL": "opus",
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "outputStyle": "Concise",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "enabledPlugins": {
    "linear@claude-plugins-official": true
  }
}
